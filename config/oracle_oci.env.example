# Oracle Cloud Infrastructure (OCI) - Autonomous Database Credentials
# Rename this file to `oracle_oci.env` when deploying to the cloud.

# The application's dal/oracle_repository.py is already completely decoupled 
# from the specific Oracle environment. Because we use "python-oracledb" in 
# thin mode, you do not need Oracle Instant Client installed.

# To migrate this tool from the local On-Premises DB to Oracle Cloud:
# 1. Provide the remote host, port, and service name below.
# 2. Or, if using an Oracle Wallet (mTLS), uncomment the TNS_ADMIN path below.
# 3. No Python code changes are required!

DB_USER=ai_hr_admin
DB_PASSWORD=your_secure_cloud_password_here
DB_HOST=adb.us-ashburn-1.oraclecloud.com
DB_PORT=1522
DB_SERVICE_NAME=your_autonomous_db_service_name_high.adb.oraclecloud.com

# Optional: If your Autonomous Database requires mTLS wallet connection:
# TNS_ADMIN=/path/to/extracted/wallet/folder
# WALLET_PASSWORD=your_wallet_password

# Scoring Component Weights (Must sum to 1.0)
WEIGHT_SKILLS_REQUIRED=0.35
WEIGHT_SKILLS_PREFERRED=0.15
WEIGHT_EXPERIENCE=0.20
WEIGHT_EDUCATION=0.10
WEIGHT_PROJECTS_CERTS=0.10
WEIGHT_GLOBAL_CONTEXT=0.10
